# Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-strong-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to local SQLite if omitted)
# Set FORCE_SQLITE=1 to force SQLite even if DB_* are set
FORCE_SQLITE=1
# DB_NAME=safesync_db
# DB_USER=safesync_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306

# Email Configuration (Defaults to console backend if EMAIL_HOST is omitted)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=webmaster@localhost
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Security & Step-Up Authentication
STEP_UP_OTP_TTL_MINUTES=10
